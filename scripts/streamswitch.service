[Unit]
Description=StreamSwitch - H.265 Stream Failover Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/streamswitch
ExecStart=/opt/streamswitch/streamswitch \
    --srt-addr localhost:8282 \
    --srt-mode caller \
    --fallback /opt/streamswitch/fallback.ts \
    --port 80 \
    --srt-timeout 2000 \
    --data-dir /opt/streamswitch/data
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

# Security hardening
NoNewPrivileges=false
ProtectSystem=strict
ReadWritePaths=/opt/streamswitch

[Install]
WantedBy=multi-user.target
